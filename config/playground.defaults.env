# WordPress Playground - Default Environment Variables
# This is a trimmed down version for local development

# Application
APPLICATION_ENV=development
WP_ENV=development
WP_DEBUG=true
WP_CACHE=false

# Site URLs
WP_HOME=https://playground.finder.dev
WP_SITEURL=/wordpress
WP_PATH=/var/www/src/wordpress
WP_UPLOADS_PATH=/var/www/src/wp-content/uploads

# Database Configuration
DB_HOST=coeval-mysql
DB_NAME=wp_playground_db
DB_USER=root
DB_PASS=abcd1234

# Redis Configuration
REDIS_DB_HOST=redis
REDIS_OBJECT_CACHE_DB_HOST=redis
REDIS_OBJECT_CACHE_DB_PORT=6379

# PHP Configuration
WP_MEMORY_LIMIT=512M
PHP_IDE_CONFIG=serverName=playground.finder.dev

# WordPress Settings
DISABLE_WP_CRON=true
WP_POST_REVISIONS=10
FORCE_SSL_ADMIN=true

# Cache Settings
ENABLE_CACHE=false
SHORTCODE_CACHE_ENABLE=false

# Feature Flags (minimal set for playground)
FEATURE_FLAG_WP_USERS_GOOGLE_SSO=false

# Xdebug (disabled by default, enable in playground.local.env)
XDEBUG_MODE=off
