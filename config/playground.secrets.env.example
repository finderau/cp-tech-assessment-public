# WordPress Playground - Secrets Configuration
# Copy this file to playground.secrets.env and fill in the values
#
# IMPORTANT: Do not commit playground.secrets.env to version control!

# WordPress Authentication Keys and Salts
# Generate unique keys at: https://api.wordpress.org/secret-key/1.1/salt/
# These are required for cookie authentication and security
AUTH_KEY='put-your-unique-phrase-here'
SECURE_AUTH_KEY='put-your-unique-phrase-here'
LOGGED_IN_KEY='put-your-unique-phrase-here'
NONCE_KEY='put-your-unique-phrase-here'
AUTH_SALT='put-your-unique-phrase-here'
SECURE_AUTH_SALT='put-your-unique-phrase-here'
LOGGED_IN_SALT='put-your-unique-phrase-here'
NONCE_SALT='put-your-unique-phrase-here'

# Database credentials (if different from defaults)
# Uncomment and modify if not using the default dev database
# DB_HOST=coeval-mysql
# DB_NAME=wp_playground_db
# DB_USER=root
# DB_PASS=abcd1234

# External API keys (add as needed)
# GOOGLE_MAPS_API_KEY=
# SENDGRID_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
