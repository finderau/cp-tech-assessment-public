{
    "name": "finder/wp-playground",
    "description": "WP playground",
    "require": {
        "johnpbloch/wordpress": "^6.9",
        "guzzlehttp/guzzle": "^7.10",
        "predis/predis": "^3.3",
        "twig/twig": "^3.22"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Finder\\WpPlayground\\": "src/",
            "Finder\\ProductData\\": "src/plugins/product-data/src/",
            "Finder\\ComparisonExperience\\": "src/plugins/comparison-experience/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Finder\\ProductData\\Tests\\": "src/plugins/product-data/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration"
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        }
    }
}
